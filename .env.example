# Copy this file to `.env.local` and fill in the values from your Supabase project
# (Project Settings -> API). `.env.local` is never committed.
#
# Only the publishable key belongs here. Never put the secret / service_role key
# in this file or any NEXT_PUBLIC_ variable: those values are sent to the browser.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Cloudflare R2 (server-side only; never prefix with NEXT_PUBLIC_). Dashboard:
# R2 Object Storage -> bucket -> Settings -> S3 API gives R2_ENDPOINT, whose leading
# id is R2_ACCOUNT_ID. Manage API tokens -> Create API token (Object Read & Write,
# this bucket only) gives the access key id and the secret, shown once.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
