# Copy this file to `.env.local` and fill in the values from your Supabase project
# (Project Settings -> API). `.env.local` is never committed.
#
# Only the publishable key belongs here. Never put the secret / service_role key
# in this file or any NEXT_PUBLIC_ variable: those values are sent to the browser.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Cloudflare R2 (server-side only; never prefix with NEXT_PUBLIC_). Dashboard:
# R2 Object Storage -> bucket -> Settings -> S3 API gives R2_ENDPOINT, whose leading
# id is R2_ACCOUNT_ID. Manage API tokens -> Create API token (Object Read & Write,
# this bucket only) gives the access key id and the secret, shown once.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=

# Database (TASK-0101, ADR-015). Server-side only.
# DATABASE_URL and SUPABASE_DB_PASSWORD are the admin connection (Project Settings -> Database
# -> Connection string, "Transaction pooler"). Only migrations, dumps and `npm run db:app-role`
# use it; the application never reads it.
DATABASE_URL=
SUPABASE_DB_PASSWORD=
# The application's restricted runtime role. Do not fill in by hand: `npm run db:app-role`
# generates the password and appends this line.
DATABASE_APP_URL=
# The outbox worker's role (bypasses RLS, cannot delete; D-259). Also written by
# `npm run db:app-role`, on the pooler's session port.
DATABASE_WORKER_URL=
# The worker starts with the server; set to `off` to keep it off (for example on a second server).
JOBS_WORKER=
# Optional: another root certificate than db/certs/supabase-root-2021-ca.crt (self-host).
DATABASE_CA_CERT_PATH=
# Optional: pg_dump 17+ when it is not on PATH (`npm run db:backup`).
PG_DUMP_PATH=
