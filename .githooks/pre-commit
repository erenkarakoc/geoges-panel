#!/bin/sh
# Commit gate (PROJECT_RULES §21.3, D-076, D-110).
#
# Enabled once per clone:   git config core.hooksPath .githooks
#
# Work goes straight to `main` (D-109), so `main` must never go red. This runs the whole
# check before every commit and refuses the commit if anything fails:
#   - record consistency, strict (a record changed in this commit carries today's stamp)
#   - type check, lint, tests, formatting
#
# To commit anyway in a genuine emergency: git commit --no-verify — and then say so in
# ai/CHANGELOG.md, because an unexplained bypass is how things drifted in the first place.

if ! command -v node >/dev/null 2>&1; then
  echo "pre-commit: node not found; cannot run the checks." >&2
  exit 1
fi

npm run --silent check:commit || {
  echo "" >&2
  echo "pre-commit: the check failed — commit refused. main must stay green (D-109, D-110)." >&2
  echo "See ai/PROJECT_RULES.md §21." >&2
  exit 1
}
