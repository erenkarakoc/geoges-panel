{
  "name": "geoges-panel",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "records": "node scripts/check-records.mjs",
    "boundaries": "node scripts/check-schema-access.mjs",
    "test:watch": "vitest",
    "test:db": "vitest run --config vitest.db.config.mts",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:backup": "node scripts/db-backup.mjs",
    "db:app-role": "node scripts/db-app-role.mjs",
    "db:reset:data": "node scripts/db-reset.mjs --data",
    "db:reset:config": "node scripts/db-reset.mjs --config",
    "db:sample": "node scripts/db-sample.mjs",
    "db:mark-real-data": "node scripts/db-mark-real-data.mjs",
    "config:export": "node scripts/config-transfer.mjs export",
    "config:import": "node scripts/config-transfer.mjs import",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run records && npm run boundaries && npm run typecheck && npm run lint && npm run test && npm run format:check",
    "check:commit": "node scripts/check-records.mjs --strict && npm run boundaries && npm run typecheck && npm run lint && npm run test && npm run format:check",
    "iam:bootstrap-owner": "node scripts/iam-bootstrap-owner.mjs",
    "jobs:status": "node scripts/jobs-cli.mjs status",
    "jobs:retry": "node scripts/jobs-cli.mjs retry",
    "jobs:rebuild": "node scripts/jobs-cli.mjs rebuild"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1137.0",
    "@aws-sdk/s3-request-presigner": "3.1137.0",
    "@base-ui/react": "1.8.0",
    "@daypicker/react": "10.0.1",
    "@napi-rs/canvas": "1.0.9",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/tur": "1.0.0",
    "@xyflow/react": "12.11.6",
    "class-variance-authority": "0.7.1",
    "client-zip": "2.5.1",
    "clsx": "2.1.1",
    "kysely": "0.29.6",
    "lucide-react": "1.46.0",
    "next": "16.3.5",
    "next-themes": "0.4.6",
    "pdfjs-dist": "6.3.289",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "tesseract.js": "7.0.0",
    "web-push": "3.6.7",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@svgr/webpack": "8.1.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-push": "3.6.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.2.0",
    "prettier": "3.9.7",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=24"
  }
}
